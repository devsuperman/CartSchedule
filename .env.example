# Copie este arquivo para .env e preencha os valores reais.
# Nunca commitar o .env (já está no .gitignore).

# PostgreSQL
POSTGRES_PASSWORD=

# Login do administrador (usuário único, ver PLANNING.md regra 15)
ADMIN_USUARIO=
# Hash da senha (nunca a senha em texto puro)
ADMIN_SENHA_HASH=

# Chave secreta usada para assinar o JWT do administrador
JWT_CHAVE_SECRETA=

# Somente produção (docker-compose.prod.yml): domínio público, sem https://
# (ex.: escala.seudominio.com.br). O DNS deve apontar para o IP do servidor.
DOMINIO=

# Opcional: link de convite do grupo do WhatsApp (ex.: https://chat.whatsapp.com/XXXX).
# O botão "Terminei!" da tela do publicador abre esse link para voltar ao grupo;
# vazio = o botão não aparece. Vai embutido no site (quem abre o site vê o link)
# e mudar exige rebuild: docker compose ... up -d --build.
WHATSAPP_GRUPO_URL=

# Opcional (produção): bucket S3 para cópia dos backups diários (deploy/backup.sh).
BACKUP_S3_BUCKET=
