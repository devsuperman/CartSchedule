# Copie este arquivo para .env e preencha os valores reais.
# Nunca commitar o .env (já está no .gitignore).

# PostgreSQL
POSTGRES_PASSWORD=

# Login do administrador (usuário único, ver PLANNING.md regra 15)
ADMIN_USUARIO=
# Hash da senha (nunca a senha em texto puro)
ADMIN_SENHA_HASH=

# Chave secreta usada para assinar o JWT do administrador
JWT_CHAVE_SECRETA=

# Somente produção (docker-compose.prod.yml): domínio público, sem https://
# (ex.: escala.seudominio.com.br). O DNS deve apontar para o IP do servidor.
DOMINIO=

# Opcional (produção): bucket S3 para cópia dos backups diários (deploy/backup.sh).
BACKUP_S3_BUCKET=
